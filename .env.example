# MongoDB (Phase 3 import + Phase 4 backend)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=retailrocket_analytics

# compact = Atlas free-tier rollups (default). Full raw import uses import_to_mongodb.py (legacy).
MONGODB_DEPLOYMENT_MODE=compact

# Bulk insert batch size for import scripts (100–50000)
MONGODB_BATCH_SIZE=10000

# Trace API (Phase 4)
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_URL=http://127.0.0.1:5173

# Frontend (Phase 5+) — copy to frontend/.env
# VITE_API_BASE_URL=http://127.0.0.1:8000
